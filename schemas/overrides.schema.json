{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://royal-road.example/schemas/overrides.schema.json",
  "type": "object",
  "required": ["schemaVersion", "songs"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "songs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "excludeOccurrenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "addOccurrences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["segmentIndices", "chordLabels", "patternIds", "note"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "segmentIndices": {"type": "array", "minItems": 4, "maxItems": 5, "items": {"type": "integer", "minimum": 0}},
                "exactStartSeconds": {"type": "number", "minimum": 0},
                "exactEndSeconds": {"type": "number", "exclusiveMinimum": 0},
                "playbackStartSeconds": {"type": "number", "minimum": 0},
                "playbackEndSeconds": {"type": "number", "exclusiveMinimum": 0},
                "chordLabels": {"type": "array", "minItems": 4, "maxItems": 5, "items": {"type": "string", "minLength": 1}},
                "patternIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "passingChordIndex": {"type": ["integer", "null"], "minimum": 1, "maximum": 3},
                "note": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
