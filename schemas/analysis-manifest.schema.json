{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://royal-road.example/schemas/analysis-manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "sourceSnapshot", "analysis", "songs"],
  "properties": {
    "schemaVersion": {"const": "3.0.0"},
    "sourceSnapshot": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "analysis": {
      "type": "object",
      "required": ["module", "revision", "configVersion"],
      "properties": {
        "module": {"const": "chord_recognition_module"},
        "revision": {"type": "string", "minLength": 7},
        "configVersion": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "songs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "audioUrl", "audioSha256", "analysisVersion", "error"],
        "properties": {
          "status": {"enum": ["analyzed", "unavailable", "failed"]},
          "audioUrl": {"type": ["string", "null"]},
          "audioSha256": {"type": ["string", "null"]},
          "analysisVersion": {"type": ["string", "null"]},
          "error": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
